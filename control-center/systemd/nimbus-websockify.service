# =============================================================================
# nimbus-websockify.service: VNC-over-WebSocket proxy for VM consoles
# =============================================================================
# What: one websockify instance on 127.0.0.1:6080 that looks up each
#       connection's VNC target in the token files the backend writes to
#       /run/nimbus-control/vnc-tokens/ (TokenFile plugin). Stops and restarts
#       together with nimbus-control.service.
# Why:  docs/PLAN.md §4.1: embedded noVNC consoles without opening VNC ports.
# =============================================================================
[Unit]
Description=Nimbus Control Center VM console proxy
Documentation=@NIMBUS_HOME_URL@
PartOf=nimbus-control.service
After=nimbus-control.service

[Service]
Type=exec
User=nimbus-control
Group=nimbus-control
ExecStart=/usr/bin/websockify --token-plugin=TokenFile --token-source=/run/nimbus-control/vnc-tokens 127.0.0.1:6080
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
