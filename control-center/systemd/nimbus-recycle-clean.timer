# =============================================================================
# nimbus-recycle-clean.timer: starts the recycle bin cleanup once a day
# =============================================================================
# What: daily, with up to an hour of random delay; catches up after downtime.
# Why:  docs/PLAN.md §4.1.
# =============================================================================
[Unit]
Description=Daily Nimbus share recycle bin cleanup

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
