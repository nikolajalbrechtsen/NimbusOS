#!/bin/sh
# =============================================================================
# postrm for nimbus-control
# =============================================================================
# What: on purge, removes what belongs to the Control Center itself:
#         - its state files (the regular files at the top of
#           /var/lib/nimbus-control: settings, share and stack records,
#           schema_version) and their migration backups;
#         - privd's cache and the package's own bookkeeping;
#         - the include block in /etc/samba/smb.conf and the two generated
#           Samba files (Samba then no longer serves the NimbusOS shares);
#         - the Avahi SMB advertisement, if privd wrote it;
#         - its two adduser.conf keys, restored to their original lines
#           unless the administrator has changed them since.
#       It never removes user data: app stacks with their data and volumes
#       (/var/lib/nimbus-control/stacks), VM disks and ISOs
#       (/var/lib/nimbus-vms), the pool and disks (/mnt/user, /mnt/disks,
#       /mnt/parity), share folders, SMB users and their passwords, the
#       managed /etc/fstab block, the SnapRAID configuration, privd's SMB
#       user list and fstab backups, or the system accounts. At the end it
#       prints what was kept and where.
#       "remove" keeps everything, as Debian does for configuration.
# Why:  docs/PLAN.md NOTE-58: purging an app must never cost a user their
#       data.
# =============================================================================
set -e

STATE=/var/lib/nimbus-control
PKGSTATE=/var/lib/nimbus-privd/package
SMB_CONF=/etc/samba/smb.conf
ADDUSER_CONF=/etc/adduser.conf
AVAHI_SMB=/etc/avahi/services/smb.service

# kept PATH TEXT: report PATH as kept, if it exists.
kept() {
	if [ -e "$1" ]; then
		printf '  %-34s %s\n' "$1" "$2"
	fi
}

# restore_adduser_key KEY OURS: put back the original line of KEY if the
# current one is still the line this package set.
restore_adduser_key() {
	key="$1"
	ours="$2"
	current="$(grep -E "^[[:space:]]*$key=" "$ADDUSER_CONF" | tail -n 1)"
	if [ "$current" != "$ours" ]; then
		return 0
	fi
	orig="$(grep -E "^[[:space:]]*$key=" "$PKGSTATE/adduser.conf.orig" | tail -n 1)"
	if [ -n "$orig" ]; then
		orig_sed="$(printf '%s' "$orig" | sed 's/[\\|&]/\\&/g')"
		sed -i -E "s|^[[:space:]]*$key=.*|$orig_sed|" "$ADDUSER_CONF"
	else
		sed -i -E "/^[[:space:]]*$key=/d" "$ADDUSER_CONF"
	fi
}

case "$1" in
	purge)
		# The Control Center's state files and their backups; stacks/ stays.
		if [ -d "$STATE" ]; then
			find "$STATE" -mindepth 1 -maxdepth 1 -type f -delete
			rm -rf "$STATE/backups"
			rmdir "$STATE/stacks" 2>/dev/null || true
			rmdir "$STATE" 2>/dev/null || true
		fi
		rm -rf /var/cache/nimbus-privd /run/nimbus-control

		# Samba: the include block (and the blank line before it), then the
		# generated files.
		if [ -f "$SMB_CONF" ] && grep -q '^# BEGIN nimbus-control' "$SMB_CONF"; then
			tmp="$(mktemp "$SMB_CONF.nimbus-purge.XXXXXX")"
			awk '
				/^# BEGIN nimbus-control/ { skip = 1; held = 0; next }
				skip && /^# END nimbus-control/ { skip = 0; next }
				skip { next }
				held { print ""; held = 0 }
				/^$/ { held = 1; next }
				{ print }
				END { if (held) print "" }
			' "$SMB_CONF" >"$tmp"
			cat "$tmp" >"$SMB_CONF"
			rm -f "$tmp"
		fi
		rm -f /etc/samba/nimbus/settings.conf /etc/samba/nimbus-shares.conf
		rmdir /etc/samba/nimbus 2>/dev/null || true

		if [ -f "$AVAHI_SMB" ] && grep -q 'Generated by nimbus-control' "$AVAHI_SMB"; then
			rm -f "$AVAHI_SMB"
		fi

		if [ -f "$PKGSTATE/adduser.conf.orig" ] && [ -f "$ADDUSER_CONF" ]; then
			restore_adduser_key EXTRA_GROUPS 'EXTRA_GROUPS="@NIMBUS_USER_EXTRA_GROUPS@"'
			restore_adduser_key ADD_EXTRA_GROUPS 'ADD_EXTRA_GROUPS=1'
		fi
		rm -rf "$PKGSTATE"
		rmdir /var/lib/nimbus-privd 2>/dev/null || true

		echo "nimbus-control: removed the Control Center's settings, caches and Samba configuration."
		echo "Samba no longer serves the NimbusOS shares. Your data was kept; delete it yourself if"
		echo "you no longer need it:"
		kept "$STATE/stacks" "app stacks with their data and volumes"
		kept /var/lib/nimbus-vms "VM disks (images/) and ISO files (isos/)"
		kept /mnt/user "the storage pool"
		kept /mnt/disks "data disks"
		kept /mnt/parity "parity disks"
		kept /srv/nimbus/shares "shared folders on the system disk"
		kept /etc/nimbus/snapraid.conf "SnapRAID configuration (needed to use the parity)"
		kept /var/lib/nimbus-privd "SMB user list and /etc/fstab backups"
		if grep -q '^# BEGIN nimbus' /etc/fstab 2>/dev/null; then
			printf '  %-34s %s\n' /etc/fstab "the '# BEGIN nimbus' block that mounts your disks"
		fi
		smb_gid="$(getent group nimbus-smb | cut -d : -f 3)"
		if [ -n "$smb_gid" ]; then
			smb_users="$(getent passwd | awk -F : -v g="$smb_gid" '$4 == g && $1 != "nimbus-guest" { printf "%s%s", sep, $1; sep = " " }')"
			printf '  %-34s %s\n' "SMB users" "${smb_users:-none} (with their Samba passwords)"
		fi
		printf '  %-34s %s\n' "system accounts" "nimbus-control, nimbus-guest and the group nimbus-smb"
		;;
esac

#DEBHELPER#

exit 0
