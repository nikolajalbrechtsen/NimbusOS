#!/bin/sh
# =============================================================================
# postrm for nimbusos-branding
# =============================================================================
# What: on removal, gives Plymouth back the distribution's default theme if
#       "nimbusos" was selected, and rebuilds the initramfs through the
#       update-initramfs trigger. On purge, regenerates the GRUB menu, because
#       /etc/default/grub.d/10-nimbusos.cfg (a conffile) is only deleted then.
# Why:  leave a bootable system that looks like Debian again.
# =============================================================================
set -e

case "$1" in
	remove)
		# The theme files are already gone, so read the configured name
		# instead of asking plymouth-set-default-theme for the effective one.
		if command -v plymouth-set-default-theme >/dev/null 2>&1 \
			&& sed -n 's/^[[:space:]]*Theme[[:space:]]*=[[:space:]]*//p' /etc/plymouth/plymouthd.conf 2>/dev/null \
				| tail -n 1 | grep -qx nimbusos; then
			plymouth-set-default-theme --reset || true
			dpkg-trigger --no-await update-initramfs || true
		fi
		;;
	purge)
		if command -v update-grub >/dev/null 2>&1 && [ -e /boot/grub/grub.cfg ]; then
			update-grub 2>&1 || echo "nimbusos-branding: update-grub failed; run 'sudo update-grub'." >&2
		fi
		;;
esac

#DEBHELPER#

exit 0
