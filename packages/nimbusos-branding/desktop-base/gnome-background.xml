<?xml version="1.0" encoding="UTF-8"?>
<!-- Nimbus Sky for desktops that read GNOME background XML (the
     desktop-background.xml and desktop-lockscreen.xml alternatives that
     desktop-base defines). nimbusos-branding, CC-BY-SA-4.0. -->
