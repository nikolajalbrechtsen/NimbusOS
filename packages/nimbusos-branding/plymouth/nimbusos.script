# =============================================================================
# nimbusos.script - NimbusOS boot splash (Plymouth "script" module)
# =============================================================================
# What: the Nimbus Dark background (vertical gradient #070b12 -> #121c2c), the
#       logo in the centre, a thin accent progress bar below it, and, when a
#       disk must be unlocked, a passphrase field with bullets and the prompt
#       text (rendered by plymouth-label).
# Why:  spec section 1 (Plymouth theme). Images are PNGs rendered from SVG
#       when the package is built (Makefile).
# =============================================================================

Window.SetBackgroundTopColor(0.027, 0.043, 0.071);
Window.SetBackgroundBottomColor(0.071, 0.110, 0.173);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
screen_x = Window.GetX();
screen_y = Window.GetY();

# --- Logo ----------------------------------------------------------------------
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = screen_x + screen_w / 2 - logo.image.GetWidth() / 2;
logo.y = screen_y + screen_h / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 10);

# --- Progress bar ----------------------------------------------------------------
track.image = Image("progress-track.png");
track.sprite = Sprite(track.image);
track.x = screen_x + screen_w / 2 - track.image.GetWidth() / 2;
track.y = logo.y + logo.image.GetHeight() + 48;
track.sprite.SetPosition(track.x, track.y, 10);

bar.original = Image("progress-bar.png");
bar.sprite = Sprite();
bar.sprite.SetPosition(track.x, track.y, 11);

fun progress_callback(duration, progress) {
	width = Math.Int(bar.original.GetWidth() * progress);
	if (width < 1) width = 1;
	bar.sprite.SetImage(bar.original.Scale(width, bar.original.GetHeight()));
}
Plymouth.SetBootProgressFunction(progress_callback);

# --- Passphrase prompt (encrypted disks) ----------------------------------------
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");
prompt.sprite = Sprite();
entry.sprite = Sprite();
bullets = [];

fun hide_prompt() {
	prompt.sprite.SetOpacity(0);
	entry.sprite.SetOpacity(0);
	for (i = 0; bullets[i]; i++)
		bullets[i].SetOpacity(0);
	track.sprite.SetOpacity(1);
	bar.sprite.SetOpacity(1);
}

fun display_password_callback(prompt_text, bullet_count) {
	track.sprite.SetOpacity(0);
	bar.sprite.SetOpacity(0);

	entry.x = screen_x + screen_w / 2 - entry.image.GetWidth() / 2;
	entry.y = logo.y + logo.image.GetHeight() + 40;
	entry.sprite.SetImage(entry.image);
	entry.sprite.SetPosition(entry.x, entry.y, 20);
	entry.sprite.SetOpacity(1);

	label = Image.Text(prompt_text, 0.906, 0.933, 0.973, 1, "Inter 12");
	prompt.sprite.SetImage(label);
	prompt.sprite.SetPosition(screen_x + screen_w / 2 - label.GetWidth() / 2, entry.y - label.GetHeight() - 12, 20);
	prompt.sprite.SetOpacity(1);

	for (i = 0; bullets[i]; i++)
		bullets[i].SetOpacity(0);
	for (i = 0; i < bullet_count && i < 24; i++) {
		if (!bullets[i])
			bullets[i] = Sprite(bullet.image);
		bullets[i].SetPosition(entry.x + 14 + i * (bullet.image.GetWidth() + 4),
			entry.y + entry.image.GetHeight() / 2 - bullet.image.GetHeight() / 2, 21);
		bullets[i].SetOpacity(1);
	}
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(hide_prompt);

# --- Messages (for example "Checking file system") -------------------------------
message.sprite = Sprite();
fun message_callback(text) {
	label = Image.Text(text, 0.553, 0.616, 0.702, 1, "Inter 11");
	message.sprite.SetImage(label);
	message.sprite.SetPosition(screen_x + screen_w / 2 - label.GetWidth() / 2, screen_y + screen_h - 64, 20);
}
Plymouth.SetMessageFunction(message_callback);
