def now_utc():
    return datetime.datetime.now(datetime.UTC).replace(microsecond=0)


def iso(ts):
    return ts.isoformat().replace("+00:00", "Z")


def require_root():
    if os.geteuid() != 0:
        raise UsageError("this command must run as root (try: sudo nimbus-update ...)")


def atomic_write(path, text, mode=0o644):
    """Write PATH completely or not at all: temp file, fsync, rename."""
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".nimbus-update.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)
        raise


@contextlib.contextmanager
def file_lock(path, blocking=False):
    """Hold an fcntl write lock on PATH (the same kind apt, dpkg and
    unattended-upgrades use, so the locks are mutually exclusive)."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o640)
    try:
        try:
            fcntl.lockf(fd, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
        except OSError as exc:
            if exc.errno in (errno.EACCES, errno.EAGAIN):
                raise Busy(path) from exc
            raise
        yield
    finally:
        os.close(fd)


def lock_is_free(path):
    """True if nobody holds PATH right now (checked without waiting)."""
    if not os.path.exists(path):
        return True
    try:
        with file_lock(path, blocking=False):
            return True
    except Busy:
        return False


def read_os_release(path=None):
    values = {}
    try:
        with open(path or OS_RELEASE, encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                parts = shlex.split(value) if value else [""]
                values[key.strip()] = parts[0] if parts else ""
    except FileNotFoundError:
        pass
    return values


# =============================================================================
# /etc/nimbusos/update.conf
