def parser():
    top = argparse.ArgumentParser(prog="nimbus-update", description="NimbusOS update tool.")
    top.add_argument("--json", action="store_true", help="print one JSON document")
    sub = top.add_subparsers(dest="command", required=True)
    sub.add_parser("status", help="show version, channel, policy and the last check")
    check = sub.add_parser("check", help="refresh package lists and list pending updates")
    check.add_argument("--scheduled", action="store_true", help="timer mode: respect policy Off, never fail")
    sub.add_parser("install", help="install all pending updates")
    sub.add_parser("auto", help="Automatic policy: upgrade NimbusOS's own packages")
    channel = sub.add_parser("channel", help="select the stable or beta channel")
    channel.add_argument("channel", choices=CHANNELS)
    channel.add_argument("--no-check", action="store_true", help="don't refresh package lists afterwards")
    policy = sub.add_parser("policy", help="select automatic, notify or off")
    policy.add_argument("policy", choices=POLICIES)
    history = sub.add_parser("history", help="list past apt runs")
    history.add_argument("--limit", type=int, default=50)
    return top


COMMANDS = {
    "status": cmd_status, "check": cmd_check, "install": cmd_install, "auto": cmd_auto,
    "channel": cmd_channel, "policy": cmd_policy, "history": cmd_history,
}


def main(argv=None):
    global LOG_STREAM
    args = parser().parse_args(argv)
    LOG_STREAM = sys.stderr if args.json else sys.stdout
    os.umask(0o022)
    try:
        return COMMANDS[args.command](args)
    except UsageError as exc:
        print(f"nimbus-update: {exc}", file=sys.stderr)
        return 2
    except Busy as exc:
        print(f"nimbus-update: busy, retrying later ({exc} is held by another update or apt run)", file=sys.stderr)
        return EX_BUSY


if __name__ == "__main__":
    sys.exit(main())
