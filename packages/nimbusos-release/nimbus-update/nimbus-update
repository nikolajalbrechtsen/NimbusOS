# =============================================================================
# apt-get update and what its errors mean
# =============================================================================

# Order matters: the first matching class wins. apt 3 (Trixie) reports
# signature problems through sqv ("OpenPGP signature verification failed",
# "Missing key", and for a changed file "Message has been manipulated"; any
# error sqv returns is a signature problem); older wording (NO_PUBKEY,
# BADSIG) is kept as well.
ERROR_CLASSES = (
    ("signature", re.compile(
        r"OpenPGP signature verification failed|Missing key|NO_PUBKEY|BADSIG|EXPKEYSIG|REVKEYSIG"
        r"|/sqv returned an error code|Message has been manipulated"
        r"|signatures were invalid|signatures couldn't be verified|is not signed|not bound", re.I)),
    ("expired", re.compile(r"\bis expired\b|is not valid yet|invalid since", re.I)),
    ("tls", re.compile(
        r"Certificate verification failed|certificate verify failed|server certificate"
        r"|TLS handshake|SSL connection|GnuTLS", re.I)),
    ("dns", re.compile(r"Temporary failure resolving|Could not resolve|Name or service not known", re.I)),
    ("unreachable", re.compile(
        r"Could not connect|Connection (timed out|refused|failed)|Unable to connect|Network is unreachable"
        r"|\b40[34]\s+Not Found|\b404\b|does not have a Release file|Failed to fetch", re.I)),
)

HINTS = {
    "signature": (
        "The {what} could not be verified, so apt ignored it and nothing from it will be installed. "
        "Make sure the keyring package is current (sudo apt install --reinstall {keyring_pkg}). "
        "If this persists, do not trust that repository and report it at {bug}."
    ),
    "expired": (
        "The {what} metadata has expired (or the system clock is far ahead). "
        "Check that the date and time are correct. If they are, the repository has not been "
        "re-signed in time; it usually is within a day. Report it at {bug} if this persists."
    ),
    "tls": (
        "The secure connection to {host} failed. Check that the date and time are correct and "
        "that no proxy or filter intercepts HTTPS, then try again."
    ),
    "dns": (
        "The name {host} could not be resolved. Check the network connection and DNS settings, "
        "then try again."
    ),
    "unreachable": (
        "{host} could not be reached. Check the network connection; if only NimbusOS is affected, "
        "GitHub Pages may be down for a moment. Try again later."
    ),
    "other": "apt reported a problem with {host}: see the message. Running 'sudo apt-get update' shows the details.",
}

URL_RE = re.compile(r"(https?|file|cdrom)://([^/\s:]+)[^\s]*")


def source_of(host):
    if host == APT_HOST:
        return "nimbusos"
    if host == DOCKER_APT_HOST:
        return "docker"
    return "debian"


def classify_apt_output(lines):
    """Turn apt-get update output into a list of error dicts.

    Each "W:"/"E:" line and each "Err:" block (the indented lines after it)
    becomes one entry with: source (nimbusos/debian/docker), kind
    (signature/expired/tls/dns/unreachable/other), host, message and hint.
    Repeated reports of the same kind for the same host are merged.
    """
    blocks = []
    current = None
    for raw in lines:
        line = raw.rstrip("\n")
        if line.startswith("Err:"):
            current = [line]
            blocks.append(current)
        elif current is not None and line.startswith(" "):
            current.append(line.strip())
        else:
            current = None
            if line.startswith(("W:", "E:")):
                blocks.append([line])
    errors = []
    seen = set()
    for block in blocks:
        text = " ".join(block)
        if text.startswith("W:") and not any(rx.search(text) for _, rx in ERROR_CLASSES):
            continue                         # harmless warnings (e.g. duplicate sources)
        if "Some index files failed to download" in text:
            continue                         # a summary of errors reported above
        match = URL_RE.search(text)
        host = match.group(2) if match else ""
        kind = next((name for name, rx in ERROR_CLASSES if rx.search(text)), "other")
        source = source_of(host) if host else "debian"
        key = (source, kind, host)
        if key in seen:
            continue
        seen.add(key)
        what = {"nimbusos": "NimbusOS repository", "docker": "Docker repository"}.get(source, "Debian repository")
        keyring_pkg = {"nimbusos": "nimbusos-archive-keyring", "docker": "nimbusos-docker-keyring"}.get(
            source, "debian-archive-keyring")
        errors.append({
            "source": source,
            "kind": kind,
            "host": host,
            "message": text[:500],
            "hint": HINTS[kind].format(what=what, host=host or "the repository", bug=BUG_REPORT_URL,
                                       keyring_pkg=keyring_pkg),
        })
    return errors


def run_streaming(argv, env):
    """Run ARGV, echo its output line by line (journal / terminal), return
    (exit status, output lines)."""
    lines = []
    with subprocess.Popen(argv, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                          text=True, encoding="utf-8", errors="replace") as proc:
        for line in proc.stdout:
            lines.append(line)
            LOG_STREAM.write(line)
            LOG_STREAM.flush()
        proc.wait()
    return proc.returncode, lines


def apt_env():
    env = dict(APT_ENV_BASE)
    for name in ("http_proxy", "https_proxy", "no_proxy", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY"):
        if name in os.environ:
            env[name] = os.environ[name]
    return env


def apt_update(lock_timeout):
    status, lines = run_streaming(
        ["apt-get", "update", "-o", f"DPkg::Lock::Timeout={lock_timeout}"], apt_env())
    errors = classify_apt_output(lines)
    if status != 0 and not errors:
        errors.append({"source": "debian", "kind": "other", "host": "", "message": "".join(lines[-5:])[:500],
                       "hint": "apt-get update failed; run 'sudo apt-get update' to see why."})
    return errors


# =============================================================================
# Pending updates (python3-apt)
# =============================================================================

def classify_origin(origins):
    """security / nimbusos / debian for a candidate version's origins."""
    if any(o.label == "Debian-Security" for o in origins):
        return "security"
    if any(o.site == APT_HOST or o.origin == APT_ORIGIN for o in origins):
        return "nimbusos"
    return "debian"


def pending_updates():
    """Packages a full upgrade would install or upgrade, grouped."""
    import apt   # python3-apt; imported here so the rest works (and tests run) without it

    cache = apt.Cache()
    cache.upgrade(dist_upgrade=True)
    groups = {"security": [], "nimbusos": [], "debian": []}
    removals = []
    for pkg in cache.get_changes():
        if pkg.marked_delete:
            removals.append(pkg.name)
            continue
        candidate = pkg.candidate
        if candidate is None:
            continue
        origins = list(candidate.origins)
        groups[classify_origin(origins)].append({
            "name": pkg.name,
            "from": pkg.installed.version if pkg.installed else None,
            "to": candidate.version,
            "origin": origins[0].origin if origins else "",
            "new": not pkg.is_installed,
        })
    for items in groups.values():
        items.sort(key=lambda item: item["name"])
    return groups, sorted(removals)


def installed_nimbus_packages():
    import apt

    cache = apt.Cache()
    return sorted(pkg.name for pkg in cache
                  if pkg.is_installed and (pkg.name.startswith("nimbus-") or pkg.name.startswith("nimbusos-")))


# =============================================================================
# Signed release notes (releases.json + releases.json.sig, NOTE-38)
# =============================================================================

def http_get(url):
    request = urllib.request.Request(url, headers={"User-Agent": "nimbus-update"})
    with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT) as response:
        return response.read()


def verify_detached(data_path, sig_path, keyring=None):
    """gpgv against the archive keyring; returns (ok, message)."""
    result = subprocess.run(["gpgv", "--keyring", keyring or ARCHIVE_KEYRING, sig_path, data_path],
                            capture_output=True, text=True, env={"PATH": APT_ENV_BASE["PATH"], "LC_ALL": "C.UTF-8"})
    return result.returncode == 0, (result.stderr or result.stdout).strip()


def fetch_releases():
    """Download, verify and cache releases.json. Returns (data, error)."""
    try:
        data = http_get(RELEASES_URL)
        signature = http_get(RELEASES_URL + ".sig")
    except (urllib.error.URLError, OSError) as exc:
        return load_cached_releases(), f"Could not download the release notes: {exc}"
    with tempfile.TemporaryDirectory(prefix="nimbus-update.") as tmp:
        data_path = os.path.join(tmp, "releases.json")
        sig_path = data_path + ".sig"
        with open(data_path, "wb") as handle:
            handle.write(data)
        with open(sig_path, "wb") as handle:
            handle.write(signature)
        ok, message = verify_detached(data_path, sig_path)
        if not ok:
            return load_cached_releases(), (
                "The release notes are not signed by the NimbusOS archive key and were ignored. "
                f"gpgv: {message}")
    try:
        parsed = json.loads(data.decode("utf-8"))
        if not isinstance(parsed.get("releases"), list):
            raise ValueError("no releases list")
    except (ValueError, UnicodeDecodeError) as exc:
        return load_cached_releases(), f"The release notes could not be read: {exc}"
    atomic_write(RELEASES_CACHE, json.dumps(parsed, indent=1) + "\n")
    return parsed, None


def load_cached_releases():
    try:
        with open(RELEASES_CACHE, encoding="utf-8") as handle:
            return json.load(handle)
    except (FileNotFoundError, ValueError):
        return None


def latest_release(releases, channel, compare):
    """Newest release for CHANNEL: stable sees stable releases only, beta sees
    both. COMPARE is a Debian version comparison (apt_pkg.version_compare)."""
    best = None
    for entry in (releases or {}).get("releases", []):
        if not isinstance(entry, dict) or "deb_version" not in entry:
            continue
        if channel == "stable" and entry.get("channel") != "stable":
            continue
        if best is None or compare(entry["deb_version"], best["deb_version"]) > 0:
            best = entry
    return best


def debian_compare(a, b):
    import apt_pkg

    apt_pkg.init_system()
    return apt_pkg.version_compare(a, b)


# =============================================================================
# Status
# =============================================================================

def reboot_state():
    required = os.path.exists(REBOOT_REQUIRED)
    packages = []
    if required:
        with contextlib.suppress(FileNotFoundError):
            with open(REBOOT_REQUIRED_PKGS, encoding="utf-8") as handle:
                packages = sorted({line.strip() for line in handle if line.strip()})
    return required, packages


def installed_release():
    values = read_os_release()
    return {
        "name": values.get("NAME", NIMBUS_NAME),
        "version": values.get("VERSION_ID", ""),
        "pretty": values.get("PRETTY_NAME", ""),
        "channel": values.get("NIMBUSOS_CHANNEL", ""),
        "deb_version": values.get("NIMBUSOS_DEB_VERSION", ""),
    }


def package_installed(name):
    """True if dpkg has NAME fully installed (no python3-apt needed)."""
    result = subprocess.run(["dpkg-query", "-W", "-f=${db:Status-Status}", name],
                            capture_output=True, text=True, env={"PATH": APT_ENV_BASE["PATH"]})
    return result.returncode == 0 and result.stdout.strip() == "installed"


def read_status():
    try:
        with open(STATUS_PATH, encoding="utf-8") as handle:
            return json.load(handle)
    except (FileNotFoundError, ValueError):
        return None


def build_status(errors, groups, removals, releases, releases_error, checked_at):
    conf = read_conf()
    required, reboot_packages = reboot_state()
    installed = installed_release()
    latest = None
    if releases:
        latest = latest_release(releases, conf["CHANNEL"], debian_compare)
    return {
        "schema": STATUS_SCHEMA,
        "checked_at": iso(checked_at) if checked_at else None,
        "ok": not errors,
        "errors": errors,
        "pending": groups,
        "counts": {name: len(items) for name, items in groups.items()},
        "removals": removals,
        "installed": installed,
        "latest": latest,
        "update_available": bool(latest and installed["deb_version"]
                                 and debian_compare(latest["deb_version"], installed["deb_version"]) > 0),
        "releases_error": releases_error,
        "reboot_required": required,
        "reboot_packages": reboot_packages,
        "channel": conf["CHANNEL"],
        "policy": conf["POLICY"],
        "desktop_metapackage_installed": package_installed(DESKTOP_METAPACKAGE),
    }


def refresh_status(errors, checked_at):
    """Recompute pending updates (no download) and store the status file."""
    groups, removals = pending_updates()
    releases, releases_error = fetch_releases()
    status = build_status(errors, groups, removals, releases, releases_error, checked_at)
    atomic_write(STATUS_PATH, json.dumps(status, indent=1) + "\n")
    return status


# =============================================================================
# Commands
# =============================================================================

def emit(args, document, text):
    if args.json:
        json.dump(document, sys.stdout, indent=1)
        sys.stdout.write("\n")
    else:
        print(text)


def describe(status):
    lines = []
    installed = status.get("installed", {})
    lines.append(f"{installed.get('pretty') or NIMBUS_NAME}, channel {status.get('channel')}, "
                 f"policy {status.get('policy')}")
    lines.append(f"Last check: {status.get('checked_at') or 'never'}")
    for error in status.get("errors", []):
        lines.append(f"Problem ({error['source']}, {error['kind']}): {error['hint']}")
    counts = status.get("counts", {})
    lines.append("Pending: {security} security, {nimbusos} NimbusOS, {debian} Debian".format(
        security=counts.get("security", 0), nimbusos=counts.get("nimbusos", 0), debian=counts.get("debian", 0)))
    latest = status.get("latest")
    if status.get("update_available") and latest:
        lines.append(f"New NimbusOS release: {latest.get('version')} ({latest.get('channel')})")
    if status.get("releases_error"):
        lines.append(status["releases_error"])
    if status.get("reboot_required"):
        lines.append("A restart is required to finish installing updates.")
    if status.get("desktop_metapackage_installed") is False:
        lines.append(DESKTOP_MISSING_TEXT)
    return "\n".join(lines)


def cmd_status(args):
    status = read_status() or build_status([], {"security": [], "nimbusos": [], "debian": []}, [], None, None, None)
    # Live values may have changed since the last check.
    conf = read_conf()
    status["channel"], status["policy"] = conf["CHANNEL"], conf["POLICY"]
    status["installed"] = installed_release()
    status["reboot_required"], status["reboot_packages"] = reboot_state()
    status["desktop_metapackage_installed"] = package_installed(DESKTOP_METAPACKAGE)
    emit(args, status, describe(status))
    return 0


def cmd_check(args):
    require_root()
    conf = read_conf()
    if args.scheduled and conf["POLICY"] == "off":
        emit(args, {"skipped": True, "policy": "off"}, "Update policy is Off; no scheduled check.")
        return 0
    with file_lock(LOCK_PATH):
        errors = apt_update(lock_timeout=120)
        status = refresh_status(errors, now_utc())
    emit(args, status, describe(status))
    if args.scheduled:
        return 0          # the status file records problems; the timer must not "fail"
    return 0 if status["ok"] else 1


def cmd_install(args):
    require_root()
    with file_lock(LOCK_PATH):
        say("==> apt-get update")
        errors = apt_update(lock_timeout=600)
        if errors:
            say("Some sources could not be refreshed; updates from them are skipped:")
            for error in errors:
                say(f"  - {error['hint']}")
        say("==> apt-get full-upgrade")
        status_code, _ = run_streaming(
            ["apt-get", "-y", "-q", "full-upgrade",
             "-o", "DPkg::Lock::Timeout=600", "-o", "APT::Status-Fd=1", *APT_WITH_RECOMMENDS, *APT_KEEP_CONFIG],
            apt_env())
        status = refresh_status(errors, now_utc())
    if status_code == 0:
        message = "Updates installed."
        if status["reboot_required"]:
            message += " Restart the computer to finish."
    else:
        message = f"apt-get full-upgrade failed (exit status {status_code}). The log above says why."
    emit(args, {"ok": status_code == 0, "exit_status": status_code, "status": status}, message)
    return 0 if status_code == 0 else 1


def cmd_auto(args):
    """Automatic policy: upgrade the installed NimbusOS packages (and pull in
    their new dependencies) without waiting for any lock (NOTE-34)."""
    require_root()
    conf = read_conf()
    if conf["POLICY"] != "automatic":
        say(f"Update policy is {conf['POLICY']}; automatic NimbusOS updates are off.")
        return 0
    with file_lock(LOCK_PATH), file_lock(UU_LOCK):
        for path in (DPKG_FRONTEND_LOCK, APT_LISTS_LOCK):
            if not lock_is_free(path):
                raise Busy(path)
        errors = apt_update(lock_timeout=0)
        if any(error["source"] == "nimbusos" for error in errors):
            refresh_status(errors, now_utc())
            say("The NimbusOS repository could not be refreshed; nothing was installed.")
            return 1
        packages = installed_nimbus_packages()
        if not packages:
            say("No NimbusOS packages are installed.")
            return 0
        # "apt-get install" marks packages as manually installed; remember
        # which were automatic and restore that afterwards.
        auto_before = set(subprocess.run(["apt-mark", "showauto", *packages], capture_output=True, text=True,
                                         env=apt_env()).stdout.split())
        status_code, _ = run_streaming(
            ["apt-get", "-y", "-q", "install", "--no-remove",
             "-o", "DPkg::Lock::Timeout=0", *APT_WITH_RECOMMENDS, *APT_KEEP_CONFIG, *packages], apt_env())
        if auto_before:
            subprocess.run(["apt-mark", "auto", *sorted(auto_before)], capture_output=True, env=apt_env())
        refresh_status(errors, now_utc())
    return 0 if status_code == 0 else 1


def cmd_channel(args):
    require_root()
    write_conf_value("CHANNEL", args.channel)
    if args.channel == "beta":
        atomic_write(BETA_SOURCES, beta_sources_text())
        text = "Beta channel selected: beta versions of NimbusOS will be offered."
    else:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(BETA_SOURCES)
        text = ("Stable channel selected. Installed beta versions stay until a stable release "
                "is newer; nothing is downgraded.")
    if not args.no_check:
        with file_lock(LOCK_PATH):
            errors = apt_update(lock_timeout=120)
            refresh_status(errors, now_utc())
    emit(args, {"channel": args.channel}, text)
    return 0


def cmd_policy(args):
    require_root()
    write_conf_value("POLICY", args.policy)
    texts = {
        "automatic": "NimbusOS updates will be installed automatically once a day.",
        "notify": "NimbusOS updates will be checked daily and shown, but not installed.",
        "off": "NimbusOS updates will not be checked automatically. 'Check now' still works.",
    }
    emit(args, {"policy": args.policy}, texts[args.policy])
    return 0


# --- history ------------------------------------------------------------------

PKG_ENTRY_RE = re.compile(r"([^\s,()]+) \(([^()]*)\)")


def parse_history(text):
    """Entries of an apt history log, oldest first."""
    entries = []
    for block in re.split(r"\n\s*\n", text):
        fields = {}
        for line in block.strip().splitlines():
            key, sep, value = line.partition(": ")
            if sep:
                fields[key.strip()] = value.strip()
        if "Start-Date" not in fields:
            continue
        entry = {
            "start": fields.get("Start-Date"),
            "end": fields.get("End-Date"),
            "command": fields.get("Commandline", ""),
            "requested_by": fields.get("Requested-By", ""),
            "error": fields.get("Error"),
            "changes": {},
        }
        for action in ("Install", "Upgrade", "Downgrade", "Remove", "Purge", "Reinstall"):
            if action in fields:
                items = []
                for name, versions in PKG_ENTRY_RE.findall(fields[action]):
                    parts = [part.strip() for part in versions.split(",")]
                    items.append({"name": name.split(":")[0], "versions": [p for p in parts if p != "automatic"],
                                  "automatic": "automatic" in parts})
                entry["changes"][action.lower()] = items
        entries.append(entry)
    return entries


def read_history(limit):
    paths = sorted(glob.glob(HISTORY_LOG + ".*.gz"),
                   key=lambda p: int(re.search(r"\.(\d+)\.gz$", p).group(1)) if re.search(r"\.(\d+)\.gz$", p) else 0,
                   reverse=True)
    texts = []
    for path in paths:
        with contextlib.suppress(OSError, EOFError):
            with gzip.open(path, "rt", encoding="utf-8", errors="replace") as handle:
                texts.append(handle.read())
    with contextlib.suppress(FileNotFoundError):
        with open(HISTORY_LOG, encoding="utf-8", errors="replace") as handle:
            texts.append(handle.read())
    entries = []
    for text in texts:
        entries.extend(parse_history(text))
    entries.reverse()                     # newest first
    return entries[:limit]


def cmd_history(args):
    entries = read_history(args.limit)
    lines = []
    for entry in entries:
        counts = ", ".join(f"{len(items)} {action}" for action, items in entry["changes"].items())
        lines.append(f"{entry['start']}  {counts or 'no changes'}  {entry['command']}")
    emit(args, {"entries": entries}, "\n".join(lines) or "No apt history yet.")
    return 0


