def read_conf(path=None):
    """CHANNEL and POLICY; unknown or invalid values fall back to the defaults."""
    conf = {"CHANNEL": "stable", "POLICY": "automatic"}
    try:
        with open(path or CONF_PATH, encoding="utf-8") as handle:
            lines = handle.read().splitlines()
    except FileNotFoundError:
        return conf
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key, value = key.strip(), value.strip().strip("\"'")
        if key == "CHANNEL" and value in CHANNELS:
            conf[key] = value
        elif key == "POLICY" and value in POLICIES:
            conf[key] = value
    return conf


def write_conf_value(key, value, path=None, default_path=None):
    """Set KEY=VALUE, keeping every other line (comments included)."""
    path = path or CONF_PATH
    default_path = default_path or CONF_DEFAULT
    try:
        with open(path, encoding="utf-8") as handle:
            lines = handle.read().splitlines()
    except FileNotFoundError:
        try:
            with open(default_path, encoding="utf-8") as handle:
                lines = handle.read().splitlines()
        except FileNotFoundError:
            lines = []
    pattern = re.compile(r"^\s*" + re.escape(key) + r"\s*=")
    replaced = False
    for index, line in enumerate(lines):
        if pattern.match(line):
            lines[index] = f"{key}={value}"
            replaced = True
    if not replaced:
        lines.append(f"{key}={value}")
    atomic_write(path, "\n".join(lines) + "\n")


