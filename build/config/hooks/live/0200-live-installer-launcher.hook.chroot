#!/bin/bash
# =============================================================================
# build/config/hooks/live/0200-live-installer-launcher.hook.chroot
# =============================================================================
# What: hides Debian's installer launchers in the live image, which
#       calamares-settings-debian ships:
#         /usr/share/applications/calamares-install-debian.desktop
#             "Install Debian" in the menu         -> NoDisplay=true
#         /etc/xdg/autostart/calamares-desktop-icon.desktop
#             copies that launcher onto the desktop -> Hidden=true
#       The live session offers "Install NimbusOS" instead
#       (includes.chroot_after_packages, deliverable 7). The keys are set in
#       the [Desktop Entry] group, replacing an existing value; running the
#       hook twice changes nothing. If Debian renames either file, the build
#       fails here instead of shipping two installers.
# Why:  one installer entry, named for NimbusOS. The files are edited in
#       place, not diverted: Calamares purges calamares-settings-debian from
#       every installed system, so nothing of this reaches the target
#       (docs/PLAN.md NOTE-62).
# =============================================================================
set -euo pipefail

me="0200-live-installer-launcher"

# set_desktop_key FILE KEY VALUE: KEY=VALUE in FILE's [Desktop Entry] group.
set_desktop_key() {
	local file="$1" key="$2" value="$3" tmp
	[[ -f "$file" ]] || {
		echo "$me: $file is missing; calamares-settings-debian has changed, so this hook needs updating." >&2
		exit 1
	}
	grep -qx '\[Desktop Entry\]' "$file" || { echo "$me: $file has no [Desktop Entry] group." >&2; exit 1; }
	tmp="$(mktemp "$file.XXXXXX")"
	awk -v k="$key" -v v="$value" '
		/^\[/ {
			if (in_entry && !done) { print k "=" v; done = 1 }
			in_entry = ($0 == "[Desktop Entry]")
			print
			next
		}
		in_entry && index($0, k "=") == 1 {
			if (!done) { print k "=" v; done = 1 }
			next
		}
		{ print }
		END { if (in_entry && !done) print k "=" v }
	' "$file" >"$tmp"
	chmod --reference="$file" "$tmp"
	mv -f "$tmp" "$file"
}

set_desktop_key /usr/share/applications/calamares-install-debian.desktop NoDisplay true
set_desktop_key /etc/xdg/autostart/calamares-desktop-icon.desktop Hidden true
echo "$me: Debian's \"Install Debian\" menu entry and desktop icon are hidden in the live session."
